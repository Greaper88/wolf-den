{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GowCatalog": {
    "Repository": "games-on-whales/gow",
    "Ref": "master",
    "AutoPopulate": true,
    "AdditionalTemplates": [
      {
        "Repository": "Greaper88/gow",
        "Ref": "plasma-container",
        "Path": "apps/plasma/assets/wolf.config.toml"
      }
    ],
    "IconBaseUrl": "https://raw.githubusercontent.com/Greaper88/wolf-logos/main/itself",
    "Icons": {
      "emby": "wolf-itself-emby.png",
      "es-de": "wolf-itself-es.png",
      "firefox": "wolf-itself-ffox.png",
      "heroic-games-launcher": "wolf-itself-heroic.png",
      "kodi": "wolf-itself-kodi.png",
      "lutris": "wolf-itself-lutris.png",
      "pegasus": "wolf-itself-pegasus.png",
      "prismlauncher": "wolf-itself-prism.png",
      "retroarch": "wolf-itself-retroarch.png",
      "steam": "wolf-itself-steam.png",
      "plasma": "wolf-itself-plasma.png",
      "wolfui": "wolf-itself-wolfui.png",
      "testball": "wolf-itself-testball.png",
      "xfce": "wolf-itself-xfce.png"
    }
  },
  "CompatibilityTools": {
    "Targets": [
      { "Name": "Fedora 43", "Path": "/etc/wolf/compatibilitytools.d/fedora43" },
      { "Name": "Ubuntu",    "Path": "/etc/wolf/compatibilitytools.d/ubuntu" }
    ]
  }
}
