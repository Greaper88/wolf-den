@page "/Apps/Edit"
@inject AppCatalog Catalog
<h3>Edit app defaults</h3>
<p>Save defaults to the catalog, then apply them to enabled profiles from Apps. Profile mount overrides are preserved.</p>
@if (_error is not null) { <div class="alert alert-warning" role="alert">@_error</div> }
@if (_saved) { <div class="alert alert-success" role="status">Defaults saved. <a href="/apps/show">Return to Apps to apply them to enabled profiles.</a></div> }
@if (_app is not null) { <AppForm AppToEdit="_app.Definition" OnValidSubmit="Save" /> }
@code {
    [SupplyParameterFromQuery] public string? AppId { get; set; }
    private CatalogApp? _app;
    private bool _saved;
    private string? _error;
    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _app = (await Catalog.GetAsync()).Apps.SingleOrDefault(a => a.Id == AppId);
            if (_app is null) _error = "Catalog app not found. Import existing profile apps from Apps first.";
        }
        catch (Exception e) { _error = e.Message; }
    }
    private async Task Save(JsonObject app)
    {
        await Catalog.SaveAsync(new CatalogApp { Id = _app!.Id, Definition = app }, _app.Definition);
        _app.Definition = app.Copy();
        _saved = true;
    }
}
