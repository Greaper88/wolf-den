@page "/Apps/Add"
@inject AppCatalog Catalog
@inject NavigationManager Navigation
<h3>Add catalog app</h3>
<p>Default mounts apply when this app is enabled for a profile.</p>
<AppForm OnValidSubmit="Save" />
@code {
    private async Task Save(JsonObject app)
    {
        await Catalog.SaveAsync(new CatalogApp { Definition = app });
        Navigation.NavigateTo("/apps/show");
    }
}
