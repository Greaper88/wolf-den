@inject DefaultAppLoader Templates

<div style="max-width: 850px">
    @if (AppToEdit is null)
    {
        <details class="mb-3">
            <summary>Start from a Wildlife or TOML template</summary>
            <div class="d-flex gap-2 my-3">
                <select class="form-select" aria-label="Wildlife template" @bind="_template">
                    @foreach (var name in DefaultAppLoader.DefaultApps) { <option>@name</option> }
                </select>
                <button class="btn btn-outline-primary" disabled="@_busy" @onclick="LoadTemplate">Load template</button>
            </div>
            <label class="form-label" for="template-toml">App TOML</label>
            <textarea id="template-toml" class="form-control font-monospace" rows="6" @bind="_toml" @bind:event="oninput"></textarea>
            <button class="btn btn-outline-secondary my-2" disabled="@_busy" @onclick="ImportToml">Read TOML</button>
            @if (_imported.Count > 1)
            {
                <p>Select an app from this document:</p>
                @foreach (var imported in _imported)
                {
                    <button class="btn btn-sm btn-outline-secondary me-2" @onclick="() => Load(imported)">@imported.Text("title")</button>
                }
            }
        </details>
    }
    @if (_error is not null) { <div class="alert alert-danger" role="alert">@_error</div> }
    <form @onsubmit="Save" @onsubmit:preventDefault>
        <fieldset disabled="@_busy">
            <label class="form-label" for="app-title">App name</label>
            <input id="app-title" class="form-control mb-3" required @bind="_title" @bind:event="oninput" />
            <AppIcon Path="@_icon" Alt="Default app icon" />
            <label class="form-label d-block" for="app-icon">Default icon URL or Wolf path (blank uses placeholder)</label>
            <input id="app-icon" class="form-control mb-3" @bind="_icon" @bind:event="oninput" />
            @if (_definition.Runner().Text("type").Equals("docker", StringComparison.OrdinalIgnoreCase))
            {
                <label class="form-label" for="app-image">Container image</label>
                <input id="app-image" class="form-control mb-3" required @bind="_image" @bind:event="oninput" />
                <label class="form-label" for="app-runner">Runner name</label>
                <input id="app-runner" class="form-control mb-3" required @bind="_runnerName" @bind:event="oninput" />
                <label class="form-label" for="app-mounts">Default mounts</label>
                <p class="text-muted">One source:/container/path[:options] per line. Source paths are on the Docker host. Shared libraries belong here.</p>
                <textarea id="app-mounts" class="form-control font-monospace mb-3" rows="4" @bind="_mounts" @bind:event="oninput"></textarea>
                <details class="mb-3">
                    <summary>Advanced runner settings</summary>
                    <label class="form-label mt-2" for="app-env">Environment variables (one NAME=value per line)</label>
                    <textarea id="app-env" class="form-control font-monospace mb-3" rows="4" @bind="_env" @bind:event="oninput"></textarea>
                    <label class="form-label" for="app-devices">Devices (one per line)</label>
                    <textarea id="app-devices" class="form-control font-monospace mb-3" rows="3" @bind="_devices" @bind:event="oninput"></textarea>
                    <label class="form-label" for="app-ports">Ports (one per line)</label>
                    <textarea id="app-ports" class="form-control font-monospace mb-3" rows="3" @bind="_ports" @bind:event="oninput"></textarea>
                    <label class="form-label" for="app-json">Base create JSON</label>
                    <textarea id="app-json" class="form-control font-monospace" rows="8" @bind="_baseJson" @bind:event="oninput"></textarea>
                </details>
            }
            else
            {
                <label class="form-label" for="app-command">Process command</label>
                <textarea id="app-command" class="form-control mb-3" rows="3" @bind="_command" @bind:event="oninput"></textarea>
            }
            <details class="mb-3">
                <summary>Streaming settings</summary>
                <label class="d-block my-2"><input type="checkbox" @bind="_compositor" /> Start virtual compositor</label>
                <label class="d-block my-2"><input type="checkbox" @bind="_audio" /> Start audio server</label>
                <label class="form-label" for="app-render">Render node</label>
                <input id="app-render" class="form-control" @bind="_render" @bind:event="oninput" />
            </details>
            <button type="submit" class="btn btn-primary">Save defaults</button>
            <a class="btn btn-outline-secondary ms-2" href="/apps/show">Back to Apps</a>
        </fieldset>
    </form>
</div>

@code {
    [Parameter] public JsonObject? AppToEdit { get; set; }
    [Parameter] public EventCallback<JsonObject> OnValidSubmit { get; set; }
    private JsonObject _definition = new();
    private string _title = "", _icon = "", _image = "", _runnerName = "", _mounts = "", _env = "", _devices = "", _ports = "", _baseJson = "{}", _command = "", _render = "";
    private string _template = "steam", _toml = "";
    private string? _error;
    private bool _busy, _compositor = true, _audio = true;
    private List<JsonObject> _imported = [];
    protected override void OnInitialized() => Load(AppToEdit ?? new JsonObject
    {
        ["id"] = Guid.NewGuid().ToString("N"), ["support_hdr"] = false,
        ["h264_gst_pipeline"] = "", ["hevc_gst_pipeline"] = "", ["av1_gst_pipeline"] = "", ["opus_gst_pipeline"] = "",
        ["runner"] = new JsonObject { ["type"] = "docker", ["env"] = new JsonArray("RUN_SWAY=true", "GOW_REQUIRED_DEVICES=/dev/input/* /dev/dri/* /dev/nvidia*") }
    });
    private void Load(JsonObject app)
    {
        if (AppToEdit is null && string.IsNullOrWhiteSpace(app.Text("icon_png_path")) && Templates.GetDefaultIcon(app) is { } icon)
        { app = app.Copy(); app["icon_png_path"] = icon; }
        _definition = app.Copy();
        _title = app.Text("title"); _icon = app.Text("icon_png_path");
        var runner = app.Runner();
        _image = runner.Text("image"); _runnerName = runner.Text("name"); _command = runner.Text("run_cmd");
        _mounts = string.Join('\n', runner.Strings("mounts")); _env = string.Join('\n', runner.Strings("env"));
        _devices = string.Join('\n', runner.Strings("devices")); _ports = string.Join('\n', runner.Strings("ports"));
        _baseJson = runner.Text("base_create_json", "{}"); _render = app.Text("render_node");
        _compositor = app["start_virtual_compositor"]?.GetValue<bool>() ?? true;
        _audio = app["start_audio_server"]?.GetValue<bool>() ?? true;
    }
    private async Task Run(Func<Task> action)
    {
        _error = null; _busy = true;
        try { await action(); } catch (Exception e) { _error = e.Message; } finally { _busy = false; }
    }
    private Task LoadTemplate() => Run(async () => { _imported = await Templates.GetAppAsync(_template); Load(_imported[0]); });
    private Task ImportToml() => Run(() => { _imported = DefaultAppLoader.ParseApps(_toml); Load(_imported[0]); return Task.CompletedTask; });
    private static List<string> Lines(string text) => text.Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
    private Task Save() => Run(async () =>
    {
        var app = _definition.Copy();
        app["title"] = _title; app["icon_png_path"] = _icon; app["render_node"] = _render;
        app["start_virtual_compositor"] = _compositor; app["start_audio_server"] = _audio;
        var runner = app.Runner();
        if (runner.Text("type").Equals("docker", StringComparison.OrdinalIgnoreCase))
        {
            runner["image"] = _image; runner["name"] = _runnerName; runner["mounts"] = WolfJson.Array(Lines(_mounts));
            runner["env"] = WolfJson.Array(Lines(_env)); runner["devices"] = WolfJson.Array(Lines(_devices));
            runner["ports"] = WolfJson.Array(Lines(_ports)); runner["base_create_json"] = _baseJson;
        }
        else runner["run_cmd"] = _command;
        AppCatalog.ValidateApp(app);
        await OnValidSubmit.InvokeAsync(app);
        _definition = app;
    });
}
