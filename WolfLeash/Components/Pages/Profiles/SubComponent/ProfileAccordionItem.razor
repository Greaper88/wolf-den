@inject AppCatalog Catalog
@inject WolfConfigurationClient Wolf

<details class="card mb-3">
    <summary class="card-header"><strong>@Profile.Text("name")</strong> <span class="text-muted ms-2">@Profile.Objects("apps").Count enabled apps</span></summary>
    <div class="card-body">
        @if (_error is not null) { <div class="alert alert-danger" role="alert">@_error</div> }
        <fieldset disabled="@_busy">
            <div class="row g-3 mb-3">
                <div class="col-md-6"><label class="form-label">Profile name<input class="form-control" @bind="_editor.Name" @bind:event="oninput" /></label></div>
                <div class="col-md-6"><label class="form-label">Icon URL or Wolf path<input class="form-control" @bind="_editor.Icon" @bind:event="oninput" /></label></div>
            </div>
            <label class="me-3"><input type="checkbox" @bind="_editor.HasPin" /> Require PIN</label>
            @if (_editor.HasPin) { <label>PIN <input class="form-control d-inline-block w-auto" type="password" inputmode="numeric" autocomplete="new-password" @bind="_editor.Pin" @bind:event="oninput" /></label> }
            <hr />
            <AppsAccordionItem Editor="_editor" />
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-primary" @onclick="Save">Save profile</button>
                @if (_confirmDelete)
                {
                    <span>Delete this profile?</span>
                    <button class="btn btn-danger" @onclick="Delete">Confirm delete</button>
                    <button class="btn btn-secondary" @onclick="() => _confirmDelete = false">Cancel</button>
                }
                else { <button class="btn btn-outline-danger" @onclick="() => _confirmDelete = true">Delete profile</button> }
            </div>
        </fieldset>
    </div>
</details>
@code {
    [Parameter, EditorRequired] public JsonObject Profile { get; set; } = null!;
    [Parameter, EditorRequired] public CatalogState CatalogState { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }
    private ProfileEditor _editor = null!;
    private bool _busy, _confirmDelete;
    private string? _error;
    protected override void OnInitialized() => _editor = new ProfileEditor(Profile, CatalogState);
    private async Task Run(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); await OnChanged.InvokeAsync(); }
        catch (Exception e) { _error = e.Message; }
        finally { _busy = false; }
    }
    private Task Save() => Run(async () =>
    {
        var (profile, links) = _editor.Build();
        await Catalog.SaveProfileAsync(_editor.Original, profile, links, CatalogState);
    });
    private Task Delete() => Run(() => Wolf.DeleteProfileAsync(_editor.Original));
}
