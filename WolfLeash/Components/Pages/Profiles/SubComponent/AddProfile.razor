@inject AppCatalog Catalog
@inject NavigationManager Navigation
<p>Create a profile, then enable its apps from the catalog under Profiles.</p>
@if (_error is not null) { <div class="alert alert-danger" role="alert">@_error</div> }
<form style="max-width: 650px" @onsubmit="Save" @onsubmit:preventDefault>
    <fieldset disabled="@_busy">
        <label class="form-label d-block">Profile name<input class="form-control" required @bind="_name" @bind:event="oninput" /></label>
        <label class="form-label d-block">Icon URL or Wolf path<input class="form-control" @bind="_icon" @bind:event="oninput" /></label>
        <ProfileTimeZonePicker @bind-Value="_timeZone" />
        <label class="form-label d-block"><input type="checkbox" @bind="_hasPin" /> Require PIN</label>
        @if (_hasPin) { <label class="form-label d-block">PIN<input class="form-control" type="password" inputmode="numeric" autocomplete="new-password" @bind="_pin" @bind:event="oninput" /></label> }
        <button type="submit" class="btn btn-primary">Create profile</button>
    </fieldset>
</form>
@code {
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    private string _name = "", _icon = "", _pin = "", _timeZone = "";
    private bool _hasPin, _busy;
    private string? _error;
    private async Task Save()
    {
        _busy = true; _error = null;
        try
        {
            var editor = new ProfileEditor(new JsonObject { ["id"] = Guid.NewGuid().ToString("N"), ["apps"] = new JsonArray() }, new CatalogState())
            { Name = _name, Icon = _icon, Pin = _pin, HasPin = _hasPin, TimeZone = _timeZone };
            var (profile, _) = editor.Build();
            await Catalog.AddProfileAsync(profile, editor.TimeZoneSetting);
            await OnValidSubmit.InvokeAsync();
            Navigation.NavigateTo("/profiles/show");
        }
        catch (Exception e) { _error = e.Message; }
        finally { _busy = false; }
    }
}
