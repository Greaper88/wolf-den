@page "/Profiles/Show"
@inject AppCatalog Catalog
@inject WolfConfigurationClient Wolf
<h3>Profiles</h3>
<p>Choose each profile's enabled apps and time zone, and review mount differences from the system defaults.</p>
<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-primary" href="/profiles/add">Add profile</a>
    <button class="btn btn-outline-secondary" disabled="@_busy" @onclick="Load">Reload profiles</button>
    <button class="btn btn-outline-secondary" disabled="@_busy" @onclick="Import">Import profile apps into catalog</button>
</div>
@if (_error is not null)
{
    <div class="alert alert-warning" role="alert">@_error <p class="mb-0">Check Wolf's API socket and reload. <a href="/apps/show">Saved app defaults remain available in Apps.</a></p></div>
}
@if (_profiles is null && _error is null) { <p>Loading profiles…</p> }
@if (_profiles is not null && _catalog is not null)
{
    @foreach (var profile in _profiles)
    {
        var profileKey = (profile.Text("id"), _revision);
        <ProfileAccordionItem @key="profileKey" Profile="profile" CatalogState="_catalog" OnChanged="Load" />
    }
    @if (_profiles.Count == 0) { <p>No profiles yet.</p> }
}
@code {
    private List<JsonObject>? _profiles;
    private CatalogState? _catalog;
    private bool _busy;
    private int _revision;
    private string? _error;
    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load()
    {
        _busy = true; _error = null;
        try { _profiles = await Wolf.GetProfilesAsync(); _catalog = await Catalog.GetAsync(); _revision++; }
        catch (Exception e) { _error = e.Message; }
        finally { _busy = false; }
    }
    private async Task Import()
    {
        _busy = true; _error = null;
        try
        {
            var profiles = await Wolf.GetProfilesAsync();
            await Catalog.ImportProfilesAsync(profiles);
            _profiles = profiles; _catalog = await Catalog.GetAsync(); _revision++;
        }
        catch (Exception e) { _error = e.Message; }
        finally { _busy = false; }
    }
}
